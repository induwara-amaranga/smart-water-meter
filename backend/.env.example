# Copy to .env and adjust.

PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL. Leave empty to use the built-in PGlite database (data in ./data/pglite).
# Example: postgresql://postgres:YOUR_PASSWORD@localhost:5432/smart_water
DATABASE_URL=
PGLITE_DIR=./data/pglite

# Load demo data (tariff, staff, customers, meters, 90 days of readings, past bills) on first start.
SEED_DEMO=true

# Change these in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-only-change-me-dev-only-change-me-dev-only
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# Customer OTP. In development the code is logged; DEV_OTP (if set) is always accepted.
DEV_OTP=123456

# MQTT. With EMBEDDED_BROKER=true the backend runs its own broker (Aedes).
# To use EMQX/Mosquitto instead, set EMBEDDED_BROKER=false and point MQTT_URL at it.
EMBEDDED_BROKER=true
MQTT_PORT=1883
MQTT_URL=mqtt://localhost:1883
MQTT_SERVICE_USER=swm-backend
MQTT_SERVICE_PASSWORD=dev-service-password-change-me
# Optional TLS listener for meters (port 8883). Paths to PEM files.
MQTT_TLS_PORT=8883
MQTT_TLS_KEY=
MQTT_TLS_CERT=

# Business rules
TIMEZONE_OFFSET_MINUTES=330
OFFLINE_AFTER_MISSED_HEARTBEATS=3
COMMAND_TIMEOUT_SEC=60
LEAK_CONTINUOUS_HOURS=3
NIGHT_START_HOUR=1
NIGHT_END_HOUR=4
NIGHT_FLOW_THRESHOLD_L=20
BILL_DUE_DAYS=14

# Comma-separated origins allowed to call the API from a browser (admin dashboard, Flutter web).
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
